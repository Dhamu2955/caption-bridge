// Phase 2 — segments become the source of truth (INVARIANT 2).
// Video is never modified; SRT is a disposable artifact regenerated from here.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

// Prisma 7 keeps the connection URL out of the schema: migrations read it from
// prisma.config.ts, the client gets it through a driver adapter.
datasource db {
  provider   = "postgresql"
  // §3 wants pgvector available from phase 2 so phase 3's embeddings need no
  // infrastructure change. No vector columns exist yet.
  extensions = [vector]
}

enum ServiceSource {
  rip
  live
}

model Service {
  id          String        @id @default(uuid())
  date        DateTime      @db.Date
  speaker     String
  title       String?
  source      ServiceSource @default(rip)
  videoPath   String        @unique
  durationMs  Int?
  /// INVARIANT 1 — the happy path trims before transcribing, so this stays 0.
  /// Set only when someone insists on transcribing an untrimmed file; export
  /// subtracts it.
  trimStartMs Int           @default(0)

  /// The video on the mandir's own YouTube channel, set once by
  /// `publish --youtube-id`. Null for the ~45 sermons a year ripped from other
  /// mandirs' streams: captions.insert only works on videos you own, and
  /// community captions no longer exist, so those can never be published.
  youtubeVideoId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  segments       Segment[]
  chunks         Chunk[]
  captionUploads CaptionUpload[]

  @@index([date])
}

/// One row per language per service, recording what is already on YouTube.
///
/// `trackId` is what makes a republish after a correction an UPDATE rather than
/// a second track in the same language — YouTube happily accepts the duplicate
/// and viewers then get two "English" options. `contentHash` makes an unchanged
/// republish free: no request, no quota.
model CaptionUpload {
  id        String @id @default(uuid())
  serviceId String
  language  String

  trackId     String
  /// sha256 of the exact SRT text uploaded.
  contentHash String
  uploadedAt  DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, language])
}

model Segment {
  id        String @id @default(uuid())
  serviceId String
  index     Int

  original    String
  translation String
  startMs     Int
  endMs       Int
  /// Diarization label, not a person's name. Null when a merge crossed speakers.
  speaker     String?

  /// §4: required from day one so no correction ever needs backfilling.
  /// "soniox" until a human touches it, then the editor's identity —
  /// hardcoded "local" until auth exists (§9).
  editedBy String @default("soniox")
  /// Null means never edited; the text is exactly as transcribed.
  editedAt DateTime?
  /// Retained on edit — corrections are the whole reason the DB is the
  /// source of truth.
  previousTranslation String?

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, index])
  @@index([serviceId, startMs])
}

/// §3: retrieval works on 1–3 minute passages, not segments — individual cues
/// are too granular to retrieve against. `startMs` is the first segment's
/// start, which is the seek target for a deep link.
model Chunk {
  id        String @id @default(uuid())
  serviceId String
  index     Int

  startMs           Int
  endMs             Int
  firstSegmentIndex Int
  lastSegmentIndex  Int

  original    String
  translation String

  service    Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  embeddings ChunkEmbedding[]

  @@unique([serviceId, index])
  @@index([serviceId, startMs])
}

/// One row per language per chunk. §3: embed BOTH languages so a Gujarati
/// query can hit an English-indexed passage.
model ChunkEmbedding {
  id       String @id @default(uuid())
  chunkId  String
  language String
  /// Model identity, so a model change can be detected and re-indexed rather
  /// than silently mixing incompatible vector spaces.
  model    String

  /// pgvector. Prisma has no native type, so this is written and queried
  /// through raw SQL in src/search/store.ts.
  embedding Unsupported("vector(384)")

  chunk Chunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@unique([chunkId, language, model])
}
