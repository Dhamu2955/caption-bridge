{
  "soniox": {
    "apiKeyEnv": "SONIOX_API_KEY",
    "baseUrl": "https://api.soniox.com/v1",
    "model": "stt-async-v5",
    "sourceLanguages": ["gu", "en"],
    "targetLanguage": "en",
    "contextTerms": [],
    "translationTerms": []
  },
  "ingest": {
    "pauseMs": 4000,
    "maxChars": 138,
    "maxSegmentMs": 20000,
    "minDisplayMs": 1500,
    "maxLineChars": 46,
    "maxLines": 3,
    "pollIntervalMs": 3000,
    "pollTimeoutMs": 3600000
  },
  "paths": { "media": "./media", "recordings": "./recordings" },
  "database": { "urlEnv": "DATABASE_URL" },
  "server": { "host": "127.0.0.1", "port": 3000 },
  "live": {
    "delayAssemblyMs": 4000,
    "delayReviewMs": 25000,
    "minDisplayMs": 1500,
    "lateSkipMs": 2000
  }
}
