# Secrets live in this file. config.json is committed, so nothing secret goes
# there — only the *names* of these variables.
#
# You no longer have to edit this by hand. `npm run dev` starts with no .env at
# all, and Settings → Keys and passwords writes these lines for you. Editing
# here works just as well; the app reads whichever it finds.
#
#   cp .env.example .env
#
# .env is gitignored. Keep it that way. A value exported in your shell always
# beats the one written here.


# ---- Required, for any captions at all -----------------------------------

# Soniox does both the transcription and the Gujarati-to-English translation.
# Get the key from console.soniox.com. Nothing can be captioned without it.
SONIOX_API_KEY=


# ---- Required, to keep anything ------------------------------------------

# Local Postgres, started by `docker compose up -d`. Live captions run fine
# without it; storing sermons, searching them and re-exporting subtitles do
# not. Localhost only (SPEC §9) — do not expose this port.
DATABASE_URL=postgresql://sermon:sermon@127.0.0.1:5433/sermon_captions


# ---- The password on every link (written for you) ------------------------

# Every page the bridge serves carries ?token=… — a vMix Browser input cannot
# type a password, so this is what stands in for one. Leave it blank and the
# first `npm run dev` generates one and writes it here, which is what keeps a
# copied link working after a restart.
#
# You should never need to type it: the homepage hands it out to any browser
# already on this network, and its Copy buttons give you complete URLs. Change
# this line to rotate it; every link already handed out then stops working.
BRIDGE_TOKEN=


# ---- Captions on a LIVE stream (optional) --------------------------------

# This one line is all live YouTube captions need. No OAuth, no Google Cloud
# project — the three variables below are a different job entirely.
#
# In YouTube Studio, open the live stream, set closed captions to
# "POST to URL", and YouTube hands you a URL ending in ?cid=...
#
# The cid identifies the stream, so treat this like a password.
YOUTUBE_INGESTION_URL=


# ---- The service, written to a Google Doc (optional) ---------------------

# Turn "Write the service to a Google Doc" on in Settings, then mint this once:
#
#     npx tsx src/cli.ts doc --auth
#
# Enable the Google Drive API on the Cloud project first. The client id and
# secret may be the same OAuth client as YouTube's below — the refresh token
# must NOT be, because the scopes differ.
GOOGLE_DOCS_CLIENT_ID=
GOOGLE_DOCS_CLIENT_SECRET=
GOOGLE_DOCS_REFRESH_TOKEN=


# ---- Caption tracks on RECORDINGS (optional) -----------------------------

# Uploads .srt files to videos that have already been published. Live captions
# use none of this — leave all three empty if that is all you do.
#
#   1. console.cloud.google.com -> new project -> enable "YouTube Data API v3"
#   2. Create an OAuth client, application type "Desktop app"
#   3. Paste the id and secret below
#   4. Run  npx tsx src/cli.ts publish --auth
#      and paste the refresh token it prints into the third line
#
# IMPORTANT: set the OAuth consent screen to "Production", not "Testing".
# Testing-mode refresh tokens expire after SEVEN DAYS — exactly the length of
# festival week. Verification is not required for personal use; an unverified
# production app just shows a warning on the one consent screen you ever see.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
