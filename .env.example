# Soniox API key. Never put this in config.json — config.json is committed.
# Copy this file to .env and put the real key there; .env is gitignored.
SONIOX_API_KEY=

# Local Postgres from docker-compose.yml. Localhost only (SPEC §9).
DATABASE_URL=postgresql://sermon:sermon@127.0.0.1:5433/sermon_captions

# YouTube, for `publish`. Only needed to put caption tracks on your own channel.
#
# Make an OAuth client (application type: Desktop app) at console.cloud.google.com
# with the YouTube Data API v3 enabled, paste the pair below, then run
#   npx tsx src/cli.ts publish --auth
# and paste the refresh token it prints into YOUTUBE_REFRESH_TOKEN.
#
# IMPORTANT: set the OAuth consent screen to "Production", not "Testing".
# Testing-mode refresh tokens expire after SEVEN DAYS — exactly the length of
# festival week. Verification is not required for personal use; an unverified
# production app just shows a warning on the one consent screen you ever see.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
